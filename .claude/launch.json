{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Room Within",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      // 4300 rather than the usual 3000: something else on this machine holds
      // 3000, which forced a different random port on every restart and kept
      // invalidating the preview link. autoPort stays on as a fallback.
      "port": 4300,
      "autoPort": true
    },
    {
      // Demo mode: no database, no login, sample content. The only way to look
      // at an admin page locally, since the real sign-in link points at the
      // live site.
      "name": "Room Within (demo)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:demo"],
      "port": 4310,
      "autoPort": true
    }
  ]
}
