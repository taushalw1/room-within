# =============================================================================
# Room Within Community — environment variables
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored and must never be committed.
#
# The app runs without any of these: it starts in demo mode with sample data,
# and the admin area opens without a login. Fill these in to make it real.
# =============================================================================

# --- Site --------------------------------------------------------------------
# No trailing slash. Used in emails, calendar feeds and Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses row-level security. Server-side only — never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ------------------------------------------------------------------
# Start with the test keys (sk_test_… / pk_test_…) until you've done a full
# run-through, then swap to live keys.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe dashboard → Developers → Webhooks → your endpoint → Signing secret.
# The endpoint URL is https://your-site/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=

# Must be a domain verified in Resend. Until then, Resend's sandbox sender
# only delivers to your own address.
EMAIL_FROM="Room Within Community <hello@yourdomain.ca>"
EMAIL_REPLY_TO=roomwithincommunity@gmail.com

# Where "someone booked a room" / "someone asked about counselling" go.
ADMIN_EMAIL=roomwithincommunity@gmail.com

# --- Cron --------------------------------------------------------------------
# Any long random string. Vercel Cron sends it as a Bearer token so the daily
# reminder job can't be triggered by anyone who finds the URL.
CRON_SECRET=
